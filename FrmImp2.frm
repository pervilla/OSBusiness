Public Function che_acc(t_usu As String, trakey As Currency, OPCION As Integer) As String
Dim wdato  As String
Dim I As Integer
Dim j As Integer
Dim ps_accusu  As rdoResultset
Dim ps_acctra  As rdoResultset
che_acc = ""
If OPCION = 1 Then
  pub_cadena = "SELECT * FROM USUARIOS WHERE USU_KEY = '" & t_usu & "'"
  Set ps_accusu = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues) ' rdConcurReadOnly) ', rdConcurLock)
  If ps_accusu.EOF Then Exit Function
  pub_cadena = "SELECT * FROM transaccion WHERE tra_KEY = '" & trakey & "'"
  Set ps_acctra = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues) ' rdConcurReadOnly) ', rdConcurLock)
  If ps_acctra.EOF Then Exit Function
  For I = 4 To 13
    For j = 93 To 102
      If Val(ps_accusu(I)) = Val(ps_acctra(j)) And Val(ps_accusu(I)) <> 0 Then
         che_acc = "Ok"
         Exit Function
      End If
    Next j
  Next I
ElseIf OPCION = 2 Then
  pub_cadena = "SELECT * FROM USUARIOS WHERE USU_KEY = '" & t_usu & "'"
  Set ps_accusu = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues) ' rdConcurReadOnly) ', rdConcurLock)
  If ps_accusu.EOF Then Exit Function
  pub_cadena = "SELECT * FROM TABLAS WHERE TAB_NUMTAB = '" & trakey & "' AND TAB_CODCIA = '00'"
  Set ps_acctra = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues) ' rdConcurReadOnly) ', rdConcurLock)
  If ps_acctra.EOF Then Exit Function
  wdato = "." & Format(trakey, "00")
  If InStr(1, Trim(ps_accusu!USU_OTROS), wdato) <> 0 Then
    che_acc = "Ok"
  End If
End If
End Function
