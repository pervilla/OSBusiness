Dim llave_busca2 As rdoResultset
Dim xvalor1 As Currency
Dim xvalor2 As Currency
Dim xtotal As Currency
Dim VAL_IGV As Currency
Dim llave_saldocaja As rdoResultset
Dim fecha_c As Date

VAL_IGV = 1 + (Val(LK_IGV) / 100)
xvalor1 = 0
xvalor2 = 0
xtotal = 0

If xtipo = "1" Then

    xtotal = SALDOCAJAGEN(0, "S", xcia)
    SALDOCAJA = xtotal
ElseIf xtipo = "2" Then
    fecha_c = Format(DateAdd("d", 1, xfecha), "dd/mm/yyyy")
    pub_cadena = "SELECT * FROM ALLOG WHERE ALL_CODCIA = '" & xcia & "' AND ALL_FECHA_DIA = '" & Format(fecha_c, "dd/mm/yyyy") & "' AND ALL_CODTRA=9999   ORDER BY ALL_NUMOPER DESC "
    Set llave_saldocaja = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues) ' rdConcurReadOnly) ', rdConcurLock)
    If llave_saldocaja.EOF Then
    xtotal = 0
    Else
    xtotal = Nulo_Valor0(llave_saldocaja!ALL_IMPORTE)
    End If
   
    
    pub_cadena = "select *  from RESUMEN_ESTADOF where cie_codcia='" & xcia & "' and cie_periodo='" & Format(xfecha, "mmyyyy") & "' and cie_idcon = '3'"
    Set llave_busca2 = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues) ' rdConcurReadOnly) ', rdConcurLock)
    If llave_busca2.EOF Then
        pub_cadena = "INSERT INTO RESUMEN_ESTADOF VALUES ('00','" & xcia & "','" & Format(xfecha, "mmyyyy") & "', 3,1," & xtotal & ")"
    Else
        pub_cadena = "UPDATE RESUMEN_ESTADOF SET CIE_VALOR= " & xtotal & " where cie_codcia='" & xcia & "' and cie_periodo='" & Format(xfecha, "mmyyyy") & "'"
    End If
    CN.Execute pub_cadena
    
    SALDOCAJA = xtotal
    
Else
    pub_cadena = "select sum(cie_valor) as tot  from RESUMEN_ESTADOF where cie_codcia='" & xcia & "' and cie_periodo='" & Format(xfecha, "mmyyyy") & "'  and cie_idcon = '3' "
    Set llave_busca = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues) ' rdConcurReadOnly) ', rdConcurLock)
    If llave_busca.EOF Then
        xtotal = 0
    Else
        xtotal = Nulo_Valor0(llave_busca!TOT)
    End If
    SALDOCAJA = xtotal
End If



End Function

