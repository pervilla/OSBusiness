    " select CAA_CODCIA,caa_codclie , caa_tipdoc , caa_signo_car , sum(caa_importe) as suma  from caracu where caa_codcia = '" & LK_CODCIA & "' and caa_fecha >= '" & wsFECHA1 & "' and " & _
    " caa_fecha <= '" & wsFECHA2 & "' and caa_cp = '" & Trim(tipoCli) & "' and caa_tipdoc not in ('DM') and " & _
    " caa_estado <> 'E' and caa_signo_car <> 0  group  by  CAA_CODCIA,caa_codclie , caa_tipdoc , caa_signo_car  ) AS TEMPORAL ON " & _
    " CLI_CODCIA = temporal.CAA_CODCIA And CLI_CODCLIE = temporal.CAA_CODCLIE WHERE CLI_CODCIA='" & LK_CODCIA & "' AND CLI_CP='" & Trim(tipoCli) & "' ORDER BY CLI_CODCLIE,CAA_TIPDOC "
