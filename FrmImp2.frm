' PROCESO DE CALCULO
 '=====================
PROCESOPOCIA:
For iCount = 0 To lstperiodo.ListCount - 1 ' Val(txtpera.Text)
 f1 = fila_ini
 c1 = c1 + 1
 wa_per1 = "01/" & Format(wfi, "mm/yyyy")
 GoSub nro_mes
 wa_per2 = wfdia & "/" & Format(wfi, "mm/yyyy")
 
 wa_per1 = Format(Left(lstperiodo.List(iCount), 10), "dd/mm/yyyy")
 wa_per2 = Format(Right(lstperiodo.List(iCount), 10), "dd/mm/yyyy")
 If Trim(xl.Cells(3, c1)) = "" Then
   xl.Cells(3, c1) = "'" & Format(wa_per1, "dd.mm.yyyy")
   xl.Cells(4, c1) = "'" & Format(wa_per2, "dd.mm.yyyy")
 End If
 sum_wres_vta = 0
 pub_cadena = "SELECT * FROM PARGEN WHERE PAR_CODCIA IN ('25','27','28','29') "
 Set ps_codcias = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues) ' rdConcurReadOnly) ', rdConcurLock)
 Do Until ps_codcias.EOF
         f1 = f1 + 1
         xl.Cells(f1, 1) = "Sede= " & Trim(ps_codcias!par_codcia) & " " & Trim(ps_codcias!par_nombre)
         pub_cadena = "SELECT DISTINCT VEM_NOMBRE FROM VEMAEST WHERE VEM_CODCIA IN ('" & Trim(ps_codcias!par_codcia) & "') AND VEM_NOMBRE <> '' AND VEM_DESACTIVO <> 'A'"
         Set X = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues) ' rdConcurReadOnly) ', rdConcurLock)
         Do Until X.EOF
            lblproceso.Caption = "Per: " & iCount + 1 & " Vend: " & Trim(X!VEM_NOMBRE)
            DoEvents
            PUB_IMPORTE = 0
            pub_cadena = "SELECT sum((far_cantidad/far_equiv) * far_precio) AS VALOR FROM FACART, ARTI, VEMAEST  WHERE " & _
            "(FAR_CODCIA = ART_CODCIA) AND (FAR_CODART = ART_KEY) AND ART_EX_IGV  <> 'A' AND " & _
            "(FAR_CODCIA = VEM_CODCIA) AND (FAR_CODVEN = VEM_CODVEN) AND FAR_CODCIA IN ('25','27','28','29')  " & _
            "AND FAR_CP = 'C' AND FAR_TIPMOV = 10 AND (FAR_FECHA >= '" & wa_per1 & "' and FAR_FECHA <= '" & wa_per2 & "') and  " & _
            "FAR_estado <> 'E' and far_estado <> 'L'  AND VEM_NOMBRE = '" & Trim(X!VEM_NOMBRE) & "' "
            Set ps_venta = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues)
            If Not ps_venta.EOF Then
               PUB_IMPORTE = PUB_IMPORTE + (Val(Nulo_Valor0(ps_venta!VALOR)) / 1.19)
            End If
            
            pub_cadena = "SELECT sum((far_cantidad/far_equiv) * far_precio) AS VALOR FROM FACART, ARTI, VEMAEST  WHERE " & _
            "(FAR_CODCIA = ART_CODCIA) AND (FAR_CODART = ART_KEY) AND ART_EX_IGV  = 'A' AND " & _
            "(FAR_CODCIA = VEM_CODCIA) AND (FAR_CODVEN = VEM_CODVEN) AND FAR_CODCIA IN ('25','27','28','29')  " & _
            "AND FAR_CP = 'C' AND FAR_TIPMOV = 10 AND (FAR_FECHA >= '" & wa_per1 & "' and FAR_FECHA <= '" & wa_per2 & "') and  " & _
            "FAR_estado <> 'E' and far_estado <> 'L'  AND VEM_NOMBRE = '" & Trim(X!VEM_NOMBRE) & "' "
            Set ps_venta = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues)
            If Not ps_venta.EOF Then
               PUB_IMPORTE = PUB_IMPORTE + (Val(Nulo_Valor0(ps_venta!VALOR)))
            End If
            
            pub_cadena = "SELECT sum((far_cantidad/far_equiv) * far_precio) AS VALOR FROM FACART, ARTI, VEMAEST  WHERE " & _
            "(FAR_CODCIA = ART_CODCIA) AND (FAR_CODART = ART_KEY) AND ART_EX_IGV  <> 'A' AND " & _
            "(FAR_CODCIA = VEM_CODCIA) AND (FAR_CODVEN = VEM_CODVEN) AND FAR_CODCIA IN ('25','27','28','29')  " & _
            "AND FAR_CP = 'C' AND FAR_TIPMOV = 97 AND (FAR_FECHA >= '" & wa_per1 & "' and FAR_FECHA <= '" & wa_per2 & "') and  " & _
            "FAR_estado <> 'E' and far_estado <> 'L'  AND VEM_NOMBRE = '" & Trim(X!VEM_NOMBRE) & "' "
            Set ps_venta = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues)
            If Not ps_venta.EOF Then
               PUB_IMPORTE = PUB_IMPORTE - (Val(Nulo_Valor0(ps_venta!VALOR)) / 1.19)
            End If
            
            pub_cadena = "SELECT sum((far_cantidad/far_equiv) * far_precio) AS VALOR FROM FACART, ARTI, VEMAEST  WHERE " & _
            "(FAR_CODCIA = ART_CODCIA) AND (FAR_CODART = ART_KEY) AND ART_EX_IGV  = 'A' AND " & _
            "(FAR_CODCIA = VEM_CODCIA) AND (FAR_CODVEN = VEM_CODVEN) AND FAR_CODCIA IN ('25','27','28','29')  " & _
            "AND FAR_CP = 'C' AND FAR_TIPMOV = 97 AND (FAR_FECHA >= '" & wa_per1 & "' and FAR_FECHA <= '" & wa_per2 & "') and  " & _
            "FAR_estado <> 'E' and far_estado <> 'L'  AND VEM_NOMBRE = '" & Trim(X!VEM_NOMBRE) & "' "
            Set ps_venta = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues)
            If Not ps_venta.EOF Then
               PUB_IMPORTE = PUB_IMPORTE - (Val(Nulo_Valor0(ps_venta!VALOR)))
            End If
            
            f1 = f1 + 1
            wres_vta = PUB_IMPORTE
            xl.Cells(f1, 2) = Trim(X!VEM_NOMBRE)
            xl.Cells(f1, c1) = wres_vta
            sum_wres_vta = sum_wres_vta + Val(wres_vta)
        '    xl.Application.Visible = True
            
          X.MoveNext
        Loop
        f1 = f1 + 1
        xl.Cells(f1, c1) = sum_wres_vta
        xl.Cells(f1, 1) = "*** TOTALES S/. "
        sum_wres_vta = 0
 ps_codcias.MoveNext
 Loop
 wfi = DateAdd("m", -1, wfi)
 nroM = Format(wfi, "mm")
Next iCount

Return

nro_mes:
If nroM = 1 Or nroM = 3 Or nroM = 5 Or nroM = 7 Or nroM = 8 Or nroM = 10 Or nroM = 12 Then
  wfdia = 31
ElseIf nroM = 2 Then
  wval = Val(Format(wfi, "yyyy")) / 4
  wvrs = wval - Int(wval)
  If wvrs <> 0 Then
  wfdia = 29
  Else
  wfdia = 28
  End If
Else
  wfdia = 30
End If
Return

End Sub

Private Sub lblbarraos_DblClick()
    If Me.WindowState = vbMaximized Then
        Me.WindowState = vbNormal
        Me.Move (Screen.Width - (Label3(5).Left + Label3(5).Width + 240)) / 2, _
                (Screen.Height - (Label3(5).Height + 540)) / 2, _
                Label3(5).Left + Label3(5).Width + 240, _
                Label3(5).Height + 540
    Else
        Me.WindowState = vbMaximized
    End If
