Private Sub cmbestper_Click()
Dim wano
Dim wmes
Dim wpo_periodo
Dim wfec1  As Date
Dim wdias
Dim wresp
Dim loc_fecha1 As Date
Dim loc_fecha2 As Date
lblestp1.Caption = ""
lblestp1.Caption = ""
If opest(0).Value Then
    lblestp1.Caption = "..."
    lblestp2.Caption = Format(LK_FECHA_DIA, "dd/mm/yyyy")
ElseIf opest(1).Value Or opest(2).Value Then
    wpo_periodo = Trim(Mid(Trim(cmbestper.Text), 10, 6))
    wano = Right(wpo_periodo, 4)
    wmes = Left(wpo_periodo, 2)
    loc_fecha1 = "01/" & wmes & "/" & wano
    If wmes = 1 Then wdias = 31
    If wmes = 2 Then
       wresp = Val(Val(wano / 4)) - Val(Int(Val(wano / 4)))
       If Val(wresp) = 0 Then
         wdias = 29
       Else
         wdias = 28
       End If
    End If
    If wmes = 3 Then wdias = 31
    If wmes = 4 Then wdias = 30
    If wmes = 5 Then wdias = 31
    If wmes = 6 Then wdias = 30
    If wmes = 7 Then wdias = 31
    If wmes = 8 Then wdias = 31
    If wmes = 9 Then wdias = 30
    If wmes = 10 Then wdias = 31
    If wmes = 11 Then wdias = 30
    If wmes = 12 Then wdias = 31
    wfec1 = wdias & "/" & wmes & "/" & wano
    loc_fecha2 = wfec1
    lblestp1.Caption = Format(loc_fecha1, "dd/mm/yyyy")
    lblestp2.Caption = Format(loc_fecha2, "dd/mm/yyyy")
End If

End Sub

