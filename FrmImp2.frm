Function rutina(xcia As String, xtipo As String, xfecha As Date, etiqAva As label) As Currency
Dim llave_busca As rdoResultset
Dim llave_busca2 As rdoResultset
Dim xvalor1 As Currency
Dim xvalor2 As Currency
Dim xtotal As Currency
Dim VAL_IGV As Currency

VAL_IGV = 1 + (Val(LK_IGV) / 100)
xvalor1 = 0
xvalor2 = 0
xtotal = 0

If xtipo = "1" Then
    etiqAva.Caption = "Sede: " & xcia & " 1/1"
    pub_cadena = "SELECT SUM(ARM_STOCK * (ARM_COSPRO / " & VAL_IGV & " )) AS TOT FROM ARTICULO,ARTI WHERE ARM_CODCIA=ART_CODCIA AND ARM_CODART=ART_KEY AND ARM_CODCIA='" & xcia & "'  AND ART_EX_IGV <>'A'"
    Set llave_busca = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues) ' rdConcurReadOnly) ', rdConcurLock)
    xvalor1 = Nulo_Valor0(llave_busca!TOT)
    
    pub_cadena = "SELECT SUM(ARM_STOCK * ARM_COSPRO ) AS TOT FROM ARTICULO,ARTI WHERE ARM_CODCIA=ART_CODCIA AND ARM_CODART=ART_KEY AND ARM_CODCIA='" & xcia & "'  AND ART_EX_IGV='A'"
    Set llave_busca2 = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues) ' rdConcurReadOnly) ', rdConcurLock)
    xvalor2 = Nulo_Valor0(llave_busca2!TOT)
    
    
    xtotal = xvalor1 + xvalor2
ElseIf xtipo = "2" Then
    pub_cadena = "select art_codcia,art_key from arti where art_codcia='" & xcia & "'"
    Set llave_busca = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues) ' rdConcurReadOnly) ', rdConcurLock)
    xvalor1 = 0
    Do Until llave_busca.EOF
        DoEvents
        'MsgBox llave_busca.AbsolutePosition
        etiqAva.Caption = "Sede: " & xcia & " " & llave_busca.AbsolutePosition & "/" & llave_busca.RowCount
        xvalor1 = xvalor1 + stock_dia(xcia, Val(llave_busca!art_key), Format(xfecha, "dd/mm/yyyy"))
        llave_busca.MoveNext
    Loop
    xtotal = xvalor1
    
    pub_cadena = "select *  from RESUMEN_ESTADOF where cie_codcia='" & xcia & "' and cie_periodo='" & Format(xfecha, "mmyyyy") & "'  and cie_idcon = '1'"
    Set llave_busca2 = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues) ' rdConcurReadOnly) ', rdConcurLock)
    If llave_busca2.EOF Then
        pub_cadena = "INSERT INTO RESUMEN_ESTADOF VALUES ('00','" & xcia & "','" & Format(xfecha, "mmyyyy") & "',1 ,1," & xtotal & ")"
    Else
        pub_cadena = "UPDATE RESUMEN_ESTADOF SET CIE_VALOR= " & xtotal & " where cie_codcia='" & xcia & "' and cie_periodo='" & Format(xfecha, "mmyyyy") & "' and cie_idcon = '1' "
    End If
    CN.Execute pub_cadena
Else
    pub_cadena = "select sum(cie_valor) as tot  from RESUMEN_ESTADOF where cie_codcia='" & xcia & "' and cie_periodo='" & Format(xfecha, "mmyyyy") & "'  and cie_idcon = '1'"
    Set llave_busca = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues) ' rdConcurReadOnly) ', rdConcurLock)
    xtotal = Nulo_Valor0(llave_busca!TOT)
    etiqAva.Caption = "Sede: " & xcia & " 1/1"

End If

rutina = xtotal

End Function

