Dim llave_busca2 As rdoResultset
Dim llave_tipocli As rdoResultset
Dim xvalor1 As Currency
Dim xvalor2 As Currency
Dim xtotal As Currency
Dim VAL_IGV As Currency
Dim ps_addidc As rdoResultset
Dim wid_add As Integer
VAL_IGV = 1 + (Val(LK_IGV) / 100)
xvalor1 = 0
xvalor2 = 0
xtotal = 0

pub_cadena = "TRUNCATE TABLE TEMP_ESTADOF"
CN.Execute pub_cadena
pub_cadena = "SELECT * FROM TABLAS WHERE TAB_CODCIA='00' AND TAB_TIPREG=144 " 'AND TAB_NUMTAB <> 1"
Set llave_tipocli = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues) ' rdConcurReadOnly) ', rdConcurLock)

If xtipo = "1" Then
    etiqAva.Caption = "Generando por Tipo de Entidad."
    Do Until llave_tipocli.EOF
        DoEvents
        pub_cadena = " SELECT SUM(CAR_IMPORTE) AS TOT FROM CARTERA,CLIENTES WHERE CAR_CODCIA=CLI_CODCIA AND CAR_CODCLIE=CLI_CODCLIE AND CAR_CP=CLI_CP " & _
            " AND CAR_CP = '" & xcp & "' AND CAR_CODCIA='" & xcia & "' AND CAR_IMPORTE <> 0 AND CAR_TIPDOC IN (" & xtipodoc & ")  AND CLI_TIPOCLI= " & llave_tipocli!TAB_NUMTAB & " "
        Set llave_busca = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues) ' rdConcurReadOnly) ', rdConcurLock)
        xvalor1 = Nulo_Valor0(llave_busca!TOT)
        
        pub_cadena = "INSERT INTO TEMP_ESTADOF VALUES (" & llave_tipocli!TAB_NUMTAB & ",'" & Trim(llave_tipocli!TAB_NOMLARGO) & "'," & xvalor1 & ")"
        CN.Execute pub_cadena
        
        llave_tipocli.MoveNext
    Loop
        
ElseIf xtipo = "2" Then
    
    Do Until llave_tipocli.EOF
        DoEvents
        pub_cadena = "SELECT * FROM CLIENTES WHERE CLI_CODCIA='" & xcia & "' AND CLI_CP='" & xcp & "' AND CLI_TIPOCLI=" & llave_tipocli!TAB_NUMTAB & ""
        Set llave_busca2 = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues) ' rdConcurReadOnly) ', rdConcurLock)
        xvalor1 = 0
        Do Until llave_busca2.EOF
            DoEvents
            etiqAva.Caption = "Sede: " & xcia & " " & llave_busca2.AbsolutePosition & "/" & llave_busca2.RowCount
            xvalor1 = xvalor1 + Val(CtaEntidad(xcia, llave_busca2!cli_codclie, xcp, xfecha, xtipodoc))
            llave_busca2.MoveNext
        Loop
        pub_cadena = "INSERT INTO TEMP_ESTADOF VALUES (" & llave_tipocli!TAB_NUMTAB & ",'" & Trim(llave_tipocli!TAB_NOMLARGO) & "'," & xvalor1 & ")"
        CN.Execute pub_cadena
        llave_tipocli.MoveNext
    Loop
    xtotal = xvalor1
    
    pub_cadena = "select *  from TEMP_ESTADOF "
    Set llave_busca2 = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues) ' rdConcurReadOnly) ', rdConcurLock)
    wid_add = idcon * 100
    Do Until llave_busca2.EOF
      wid_add = wid_add + 1
      xtotal = Nulo_Valor0(llave_busca2!saldo)
      pub_cadena = "select *  from RESUMEN_ESTADOF where cie_codcia='" & xcia & "' and cie_periodo='" & Format(xfecha, "mmyyyy") & "' and cie_idcon=" & wid_add & ""
      Set ps_addidc = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues) ' rdConcurReadOnly) ', rdConcurLock)
      If ps_addidc.EOF Then
         pub_cadena = "INSERT INTO RESUMEN_ESTADOF VALUES ('00','" & xcia & "','" & Format(xfecha, "mmyyyy") & "'," & wid_add & ",1," & xtotal & ")"
      Else
         pub_cadena = "UPDATE RESUMEN_ESTADOF SET CIE_VALOR= " & xtotal & " where cie_codcia='" & xcia & "' and cie_periodo='" & Format(xfecha, "mmyyyy") & "' AND CIE_IDCON = " & wid_add & " "
      End If
      CN.Execute pub_cadena
      llave_busca2.MoveNext
    Loop
Else
    etiqAva.Caption = "Resumen.." & xcia
    wid_add = idcon * 100
    Do Until llave_tipocli.EOF
        wid_add = wid_add + 1
        pub_cadena = "select * from RESUMEN_ESTADOF where cie_codcia='" & xcia & "' and cie_periodo='" & Format(xfecha, "mmyyyy") & "'  and cie_idcon = " & wid_add & ""
        Set llave_busca = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues) ' rdConcurReadOnly) ', rdConcurLock)
        If llave_busca.EOF Then
         xvalor1 = 0
        Else
         xvalor1 = Nulo_Valor0(llave_busca!cie_valor)
        End If
        pub_cadena = "INSERT INTO TEMP_ESTADOF VALUES (" & llave_tipocli!TAB_NUMTAB & ",'" & Trim(llave_tipocli!TAB_NOMLARGO) & "'," & xvalor1 & ")"
        CN.Execute pub_cadena
        
        llave_tipocli.MoveNext
    Loop
    
End If



End Sub


Public Function SALDOCAJA(xcia As String, xtipo As String, xfecha As Date) As Currency
