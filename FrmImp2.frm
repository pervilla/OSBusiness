    If Not ps_almacenes.EOF Then sw_saldo_stock = sw_saldo_stock + Val(Nulo_Valor0(ps_almacenes!STOCK_TRANSITO))
Else
    pub_cadena = "SELECT  Sum ((ST01.ARM_STOCK ) * ST01.ARM_cospro) " & _
     " AS STOCK  FROM ARTICULO AS ST01 Where ST01.ARM_CODCIA= '" & LK_CODCIA & "' "
    Set X = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues) ' rdConcurReadOnly) ', rdConcurLock)
