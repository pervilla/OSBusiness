     " AS STOCK  FROM ARTICULO AS ST01 , ARTICULO AS ST02, ARTICULO AS ST04, ARTICULO As ST08 Where " & _
     " (ST01.ARM_CODART = ST02.ARM_CODART) AND  (ST02.ARM_CODART = ST04.ARM_CODART) AND (ST04.ARM_CODART = ST08.ARM_CODART) AND ST01.ARM_CODCIA= '01' AND ST02.ARM_CODCIA= '02' AND  ST04.ARM_CODCIA= '04' AND  ST08.ARM_CODCIA= '08' "
    Set X = CN.OpenResultset(pub_cadena, rdOpenKeyset, rdConcurValues) ' rdConcurReadOnly) ', rdConcurLock)
    sw_saldo_stock = 0
    pub_cadena = "SELECT SUM(FAR_CANTIDAD * FAR_COSPRO) STOCK_TRANSITO FROM facart WHERE FAR_OTRA_CIA IN ('01','02','04','08') AND FAR_OTRA_CIA <> '' AND  FAR_TIPMOV = 100 AND  FAR_TRANSITO = 'T' AND FAR_ESTADO <> 'E' AND  FAR_FECHA >= '" & Format(DateAdd("d", -30, LK_FECHA_DIA), "dd/mm/yyyy") & "' AND FAR_ESTADO2 <> 'L' "
